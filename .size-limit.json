[
  {
    "name": "@visora/core (gz)",
    "path": "packages/core/dist/index.js",
    "import": "*",
    "limit": "12 kB",
    "gzip": true
  },
  {
    "name": "@visora/core + renderer-dom (gz)",
    "path": ["packages/core/dist/index.js", "packages/renderer-dom/dist/index.js"],
    "import": {
      "packages/core/dist/index.js": "{ createViewer }",
      "packages/renderer-dom/dist/index.js": "{ mount }"
    },
    "limit": "16 kB",
    "gzip": true
  }
]
