[
  {
    "name": "@gallerist/core (gz)",
    "path": "packages/core/dist/index.js",
    "import": "*",
    "limit": "12 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/core + renderer-dom (gz)",
    "path": ["packages/core/dist/index.js", "packages/renderer-dom/dist/index.js"],
    "import": {
      "packages/core/dist/index.js": "{ createViewer }",
      "packages/renderer-dom/dist/index.js": "{ mount }"
    },
    "limit": "16.5 kB",
    "gzip": true
  },
  {
    "name": "core + renderer-dom + thumbnails (gz)",
    "path": [
      "packages/core/dist/index.js",
      "packages/renderer-dom/dist/index.js",
      "packages/plugin-thumbnails/dist/index.js"
    ],
    "import": {
      "packages/core/dist/index.js": "{ createViewer }",
      "packages/renderer-dom/dist/index.js": "{ mount }",
      "packages/plugin-thumbnails/dist/index.js": "{ thumbnails }"
    },
    "limit": "24 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/react (gz)",
    "path": "packages/react/dist/index.js",
    "import": "{ Gallerist, useGallerist, useCurrentItem }",
    "ignore": ["react", "react-dom", "@gallerist/core", "@gallerist/renderer-dom"],
    "limit": "3 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/plugin-pins (gz)",
    "path": "packages/plugin-pins/dist/index.js",
    "import": "{ pins }",
    "ignore": ["@gallerist/core"],
    "limit": "4.03 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/plugin-captions (gz)",
    "path": "packages/plugin-captions/dist/index.js",
    "import": "{ captions }",
    "ignore": ["@gallerist/core"],
    "limit": "1 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/plugin-save (gz)",
    "path": "packages/plugin-save/dist/index.js",
    "import": "{ download }",
    "ignore": ["@gallerist/core", "client-zip"],
    "limit": "1.2 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/plugin-view (gz)",
    "path": "packages/plugin-view/dist/index.js",
    "import": "{ view }",
    "ignore": ["@gallerist/core"],
    "limit": "2.4 kB",
    "gzip": true
  },
  {
    "name": "theme base.css (gz)",
    "path": "packages/theme-default/src/base.css",
    "limit": "10 kB",
    "gzip": true
  },
  {
    "name": "theme gallery.css skin (gz)",
    "path": "packages/theme-default/src/gallery.css",
    "limit": "6 kB",
    "gzip": true
  },
  {
    "name": "theme console.css skin (gz)",
    "path": "packages/theme-default/src/console.css",
    "limit": "6 kB",
    "gzip": true
  },
  {
    "name": "theme editorial.css skin (gz)",
    "path": "packages/theme-default/src/editorial.css",
    "limit": "6 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/cdn global build (gz)",
    "path": "packages/cdn/dist/gallerist.umd.js",
    "limit": "35 kB",
    "gzip": true
  }
]
