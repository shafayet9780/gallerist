[
  {
    "name": "@gallerist/core (gz)",
    "path": "packages/core/dist/index.js",
    "import": "*",
    "limit": "12 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/core + renderer-dom (gz)",
    "path": ["packages/core/dist/index.js", "packages/renderer-dom/dist/index.js"],
    "import": {
      "packages/core/dist/index.js": "{ createViewer }",
      "packages/renderer-dom/dist/index.js": "{ mount }"
    },
    "limit": "16 kB",
    "gzip": true
  },
  {
    "name": "core + renderer-dom + thumbnails (gz)",
    "path": [
      "packages/core/dist/index.js",
      "packages/renderer-dom/dist/index.js",
      "packages/plugin-thumbnails/dist/index.js"
    ],
    "import": {
      "packages/core/dist/index.js": "{ createViewer }",
      "packages/renderer-dom/dist/index.js": "{ mount }",
      "packages/plugin-thumbnails/dist/index.js": "{ thumbnails }"
    },
    "limit": "24 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/react (gz)",
    "path": "packages/react/dist/index.js",
    "import": "{ Gallerist, useGallerist }",
    "ignore": ["react", "react-dom", "@gallerist/core", "@gallerist/renderer-dom"],
    "limit": "3 kB",
    "gzip": true
  },
  {
    "name": "@gallerist/plugin-pins (gz)",
    "path": "packages/plugin-pins/dist/index.js",
    "import": "{ pins }",
    "ignore": ["@gallerist/core"],
    "limit": "4 kB",
    "gzip": true
  }
]
