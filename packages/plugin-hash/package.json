{
  "name": "@visora/plugin-hash",
  "version": "0.0.0",
  "description": "Visora plugin — deep-link the cursor to the URL hash (#g=&i=), with back/forward.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@visora/core": "workspace:^"
  },
  "devDependencies": {
    "@visora/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
