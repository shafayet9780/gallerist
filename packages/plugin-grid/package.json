{
  "name": "@visora/plugin-grid",
  "version": "0.2.0",
  "description": "Visora plugin — in-viewer contact-sheet grid (grouped, windowed); click a cell to jump.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@visora/core": "workspace:^"
  },
  "devDependencies": {
    "@visora/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shafayet9780/visora.git",
    "directory": "packages/plugin-grid"
  },
  "homepage": "https://github.com/shafayet9780/visora#readme",
  "bugs": {
    "url": "https://github.com/shafayet9780/visora/issues"
  },
  "author": "Shafayet Ahmmed",
  "keywords": [
    "lightbox",
    "gallery",
    "image-viewer",
    "media-viewer",
    "photo-gallery",
    "carousel",
    "zoom",
    "pan",
    "overlays",
    "headless",
    "framework-agnostic",
    "virtualized",
    "nested-gallery"
  ],
  "publishConfig": {
    "access": "public"
  }
}
