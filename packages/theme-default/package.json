{
  "name": "@gallerist/theme-default",
  "version": "0.2.0",
  "description": "Default Gallerist theme — pure CSS, no JS dependency. Driven by --gallerist-* custom properties.",
  "license": "MIT",
  "sideEffects": ["*.css"],
  "files": ["src", "LICENSE", "README.md"],
  "exports": {
    "./gallerist.css": "./src/gallerist.css",
    "./base.css": "./src/base.css",
    "./gallery.css": "./src/gallery.css",
    "./console.css": "./src/console.css",
    "./pins.css": "./src/pins.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"process.stdout.write('theme-default: CSS only, no build step\\n')\"",
    "typecheck": "node -e \"process.exit(0)\"",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shafayet9780/gallerist.git",
    "directory": "packages/theme-default"
  },
  "homepage": "https://github.com/shafayet9780/gallerist#readme",
  "bugs": {
    "url": "https://github.com/shafayet9780/gallerist/issues"
  },
  "author": "Shafayet Ahmmed",
  "keywords": [
    "lightbox",
    "gallery",
    "image-viewer",
    "media-viewer",
    "photo-gallery",
    "carousel",
    "zoom",
    "pan",
    "overlays",
    "headless",
    "framework-agnostic",
    "virtualized",
    "nested-gallery",
    "css",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  }
}
