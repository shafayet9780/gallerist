{
  "name": "@visora/react",
  "version": "0.2.0",
  "description": "React adapter for Visora — <Visora> component, useVisora() hook, JSX overlay/region portals.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@visora/core": "workspace:^",
    "@visora/renderer-dom": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@visora/core": "workspace:*",
    "@visora/renderer-dom": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shafayet9780/visora.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/shafayet9780/visora#readme",
  "bugs": {
    "url": "https://github.com/shafayet9780/visora/issues"
  },
  "author": "Shafayet Ahmmed",
  "keywords": [
    "lightbox",
    "gallery",
    "image-viewer",
    "media-viewer",
    "photo-gallery",
    "carousel",
    "zoom",
    "pan",
    "overlays",
    "headless",
    "framework-agnostic",
    "virtualized",
    "nested-gallery",
    "react",
    "react-component",
    "hook"
  ],
  "publishConfig": {
    "access": "public"
  }
}
