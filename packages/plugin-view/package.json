{
  "name": "@gallerist/plugin-view",
  "version": "0.5.2",
  "description": "Gallerist plugin — a View menu in the toolbar: switch the thumbnails rail layout (stacked or row) and the colour scheme (dark or light) on an open viewer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@gallerist/core": "workspace:>=0.3.0 <1"
  },
  "devDependencies": {
    "@gallerist/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shafayet9780/gallerist.git",
    "directory": "packages/plugin-view"
  },
  "homepage": "https://github.com/shafayet9780/gallerist#readme",
  "bugs": {
    "url": "https://github.com/shafayet9780/gallerist/issues"
  },
  "author": "Shafayet Ahmmed",
  "keywords": [
    "lightbox",
    "gallery",
    "image-viewer",
    "media-viewer",
    "photo-gallery",
    "carousel",
    "zoom",
    "pan",
    "overlays",
    "headless",
    "framework-agnostic",
    "virtualized",
    "nested-gallery"
  ],
  "publishConfig": {
    "access": "public"
  }
}
